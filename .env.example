# OpenPlex — copy to .env and fill in. Never commit real keys.

# Bind address. Loopback is the default. Non-loopback requires OPENPLEX_AUTH_TOKEN.
OPENPLEX_BIND=127.0.0.1
PORT=33888

# Data and media
OPENPLEX_DATA_PATH=.data
OPENPLEX_MEDIA_PATH=.data/media
OPENPLEX_MEDIA_URL=http://127.0.0.1:33888

# Optional second process for catalog/metadata lookups
OPENPLEX_CRAWL_URL=http://127.0.0.1:33889
OPENPLEX_CRAWL_PORT=33889
OPENPLEX_UPSTREAM_URL=

# Required when binding off loopback
OPENPLEX_AUTH_TOKEN=

# Metadata
KMDB_API_KEY=

# Agent
DEEPSEEK_API_KEY=
OPENPLEX_AGENT_PROVIDER=deepseek
OPENPLEX_GPT_OAUTH_CLIENT_ID=
OPENPLEX_GPT_OAUTH_PATH=
OPENPLEX_GPT_OAUTH_AUTHORIZE_URL=
OPENPLEX_GPT_OAUTH_TOKEN_URL=
OPENPLEX_GPT_OAUTH_REDIRECT=
OPENPLEX_GPT_CHAT_URL=

# Tests only
OPENPLEX_E2E_UPSTREAM_PORT=
